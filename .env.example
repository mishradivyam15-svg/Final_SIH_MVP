# Base URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# When true, the app runs entirely on the local mock data layer
# (src/data/mockData.ts via src/services/mockApi.ts) and makes no
# network calls. Set to false once the backend team's endpoints
# are ready to demo real integration.
VITE_USE_MOCK_DATA=true

# --- Backend (used by backend/database.py, not the frontend build) --------

# MongoDB Atlas connection string. Required — the backend refuses to start
# without it. Create a free M0 cluster at https://cloud.mongodb.com, add a
# database user, allow access from anywhere (0.0.0.0/0) under Network
# Access, then copy the connection string from Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
