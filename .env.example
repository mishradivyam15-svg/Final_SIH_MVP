# Base URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# When true, the app runs entirely on the local mock data layer
# (src/data/mockData.ts via src/services/mockApi.ts) and makes no
# network calls. Set to false once the backend team's endpoints
# are ready to demo real integration.
VITE_USE_MOCK_DATA=true
